# Default ignored files
/shelf/
/.idea/
# Environment-dependent path to Maven home directory
/mavenHomeManager.xml

# Gradle / build
gdx/.gradle/
gdx/build/
gdx/*/build/
gdx/local.properties
gdx/teavm/build/
.DS_Store

# Сырьё нейросети (assets_src/raw) держим в git: это единственный экземпляр
# исходников, воспроизвести их генерацией заново нельзя.
gdx/ios/build/
gdx/android/build/
gdx/tools/build/

# Черновики генератора ассетов: сырые ответы модели и отклонённые попытки.
tools/artgen/smoke_out/
tools/artgen/__pycache__/

# Отклонённые попытки генерации: 98 МБ, каждая заменена принятым ассетом рядом.
# Принятые исходники в assets_src/raw остаются в git по правилу выше.
assets_src/raw/attempts/

# Рабочие файлы генератора: контактные листы, журнал запросов, логи прогонов.
tools/artgen/*.png
tools/artgen/*.log
tools/artgen/runs.jsonl
tools/artgen/__pycache__/

# Артефакты сборки IDE и Kotlin.
gdx/.kotlin/
gdx/*/bin/

# Мультиплеер: служебный кэш Supabase CLI и локальные ключи проекта.
# Ключи живут в переменных окружения и в настройках Vercel, в git их нет.
server/supabase/.temp/
server/.env
server/.env.local
server/.vercel/
