# Доступы к проекту Supabase. Скопировать в server/.env и заполнить своими
# значениями: этот файл в git, а server/.env — нет.
#
# Где взять: Supabase → Project Settings → API Keys.
# Секретный ключ обходит RLS, поэтому он живёт только на сервере и в переменных
# окружения Vercel. В клиент игры он не попадает никогда.

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PROJECT_REF=<ref>

# Ключ для клиента игры и для анонимного входа. Публичный по назначению.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Ключ серверной функции. Секрет.
SUPABASE_SECRET_KEY=sb_secret_...

# Пароль базы: нужен только для миграций через supabase CLI.
SUPABASE_DB_PASS=...
